{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "prisma/seed.ts", "tests/**/*.ts"]
}
