HOST=127.0.0.1
PORT=3000

# Use the password for the sprintly role in your local PostgreSQL instance.
DATABASE_URL=postgresql://sprintly:replace_me@127.0.0.1:5432/sprintly

# Set a random signing secret of at least 32 UTF-8 bytes before starting the API.
AUTH_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900

# Choose local demo passwords before running npm run db:seed.
DEMO_OWNER_PASSWORD=
DEMO_MEMBER_PASSWORD=
