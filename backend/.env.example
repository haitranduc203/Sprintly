HOST=127.0.0.1
PORT=3000

# Use a local password and update DATABASE_URL to match.
POSTGRES_DB=sprintly
POSTGRES_USER=sprintly
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sprintly:replace_me@127.0.0.1:5432/sprintly

# Choose local demo passwords before running npm run db:seed.
DEMO_OWNER_PASSWORD=
DEMO_MEMBER_PASSWORD=
