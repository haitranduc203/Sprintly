<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/account_toolbar"
        style="@style/Widget.Sprintly.WorkspaceToolbar"
        app:navigationContentDescription="@string/workspace_back"
        app:navigationIcon="@drawable/ic_auth_back"
        app:title="@string/auth_account" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
      <LinearLayout
        android:id="@+id/profile_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sprintly.WorkspaceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="144dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="106dp"
                        android:background="@drawable/bg_profile_cover"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/account_avatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_workspace_avatar"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:saveEnabled="false"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/orbix_selection"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:saveEnabled="false"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/account_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:saveEnabled="false"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/retry_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@color/orbix_warning_container"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_refresh_unavailable"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/orbix_warning" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auth_refresh_unavailable_description"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/orbix_warning" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                style="@style/Widget.Sprintly.AuthButton"
                android:layout_marginTop="12dp"
                android:text="@string/auth_retry" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/retry_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/auth_checking_session"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/orbix_selection" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/auth_logout"
            android:textColor="@color/orbix_error"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_workspace_logout"
            app:iconTint="@color/orbix_error"
            app:strokeColor="@color/orbix_divider" />
      </LinearLayout>
    </ScrollView>
</LinearLayout>
