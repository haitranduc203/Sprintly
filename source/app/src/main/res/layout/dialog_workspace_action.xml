<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/action_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/orbix_on_surface"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/action_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/orbix_on_surface_variant"
            android:visibility="gone" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/action_name"
            style="@style/Widget.Sprintly.AuthField">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/action_name_input"
                style="@style/Widget.Sprintly.AuthInput"
                android:inputType="textCapSentences"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/action_description"
            style="@style/Widget.Sprintly.AuthField"
            android:hint="@string/workspace_description"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/action_description_input"
                style="@style/Widget.Sprintly.AuthInput"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/member_lookup"
            style="@style/Widget.Sprintly.WorkspaceTextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/workspace_member_lookup"
            android:visibility="gone" />
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/member_candidate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:textColor="@color/orbix_on_surface"
            android:visibility="gone"
            app:buttonTint="@color/orbix_selection" />
        <TextView
            android:id="@+id/action_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/orbix_error"
            android:visibility="gone" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/action_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/workspace_sending"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/orbix_selection" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_retry_session"
            style="@style/Widget.Sprintly.WorkspaceTextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_submit"
            style="@style/Widget.Sprintly.WorkspaceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_cancel"
            style="@style/Widget.Sprintly.WorkspaceTextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/workspace_cancel" />
    </LinearLayout>
</ScrollView>
