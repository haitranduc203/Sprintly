<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_form"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/up_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_back_to_login"
                android:src="@drawable/ic_auth_back"
                android:visibility="gone" />

            <include layout="@layout/view_auth_wordmark" />
        </LinearLayout>

        <ImageView
            android:id="@+id/illustration"
            android:layout_width="match_parent"
            android:layout_height="152dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_auth_illustration"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/ic_auth_illustration" />

        <TextView
            android:id="@+id/auth_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auth_login"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/auth_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/auth_login_description"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/expired_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:background="@color/orbix_warning_container"
            android:padding="12dp"
            android:text="@string/auth_session_expired"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/orbix_warning"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/display_name_layout"
            style="@style/Widget.Sprintly.AuthField"
            android:hint="@string/auth_display_name"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/display_name_input"
                style="@style/Widget.Sprintly.AuthInput"
                android:autofillHints="personName"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:nextFocusForward="@id/email_input" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/email_layout"
            style="@style/Widget.Sprintly.AuthField"
            android:hint="@string/auth_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_input"
                style="@style/Widget.Sprintly.AuthInput"
                android:autofillHints="username,emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:nextFocusForward="@id/password_input" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_layout"
            style="@style/Widget.Sprintly.AuthField"
            android:hint="@string/auth_password"
            android:saveEnabled="false"
            app:endIconContentDescription="@string/auth_password_visibility"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_input"
                style="@style/Widget.Sprintly.AuthInput"
                android:autofillHints="password"
                android:imeOptions="actionDone|flagNoPersonalizedLearning"
                android:inputType="textPassword"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirm_layout"
            style="@style/Widget.Sprintly.AuthField"
            android:hint="@string/auth_confirm_password"
            android:saveEnabled="false"
            android:visibility="gone"
            app:endIconContentDescription="@string/auth_confirmation_visibility"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirm_input"
                style="@style/Widget.Sprintly.AuthInput"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone|flagNoPersonalizedLearning"
                android:inputType="textPassword"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/form_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="?attr/colorErrorContainer"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_button"
            style="@style/Widget.Sprintly.AuthButton"
            android:layout_marginTop="16dp"
            android:gravity="start|center_vertical"
            android:text="@string/auth_login"
            android:textColor="@color/auth_login_button_text"
            app:backgroundTint="@color/auth_login_button_background"
            app:icon="@drawable/ic_auth_arrow"
            app:iconGravity="end"
            app:iconSize="20dp"
            app:iconTint="@color/auth_login_button_text" />

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                app:indicatorColor="@color/orbix_selection"
                app:indicatorSize="20dp"
                app:trackThickness="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/auth_sending"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/switch_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_no_account"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/switch_form"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/auth_register"
                android:textColor="@color/orbix_selection" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
