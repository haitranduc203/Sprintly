<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbix_surface"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/workspace_toolbar"
        style="@style/Widget.Sprintly.WorkspaceToolbar"
        app:title="@string/workspace_title">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/workspace_profile"
            style="@style/Widget.Sprintly.WorkspaceIconButton"
            android:layout_gravity="end"
            android:contentDescription="@string/auth_account"
            android:src="@drawable/ic_workspace_profile" />
    </com.google.android.material.appbar.MaterialToolbar>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/workspace_items"
            style="@style/Widget.Sprintly.WorkspaceList"
            android:paddingTop="8dp"
            android:visibility="gone" />
        <include
            android:id="@+id/workspace_status"
            layout="@layout/view_workspace_status" />
    </FrameLayout>
</LinearLayout>
