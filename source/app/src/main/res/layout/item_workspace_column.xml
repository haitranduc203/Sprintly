<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_workspace_lane"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <View
            android:id="@+id/column_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_workspace_dot"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/column_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/orbix_on_surface" />
        <TextView
            style="@style/Widget.Sprintly.WorkspaceRole"
            android:backgroundTint="@color/orbix_divider"
            android:importantForAccessibility="no"
            android:text="@string/workspace_column_empty_count"
            android:textColor="@color/orbix_on_surface_variant" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/column_more"
            style="@style/Widget.Sprintly.WorkspaceIconButton"
            android:contentDescription="@string/workspace_column_edit"
            android:src="@drawable/ic_workspace_more" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/workspace_column_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/orbix_on_surface_variant" />
</LinearLayout>
