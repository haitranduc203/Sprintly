<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    android:background="@color/orbix_warning_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingVertical="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workspace_offline_cached"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/orbix_warning" />

        <TextView
            android:id="@+id/offline_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workspace_offline_connect"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/orbix_warning" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/offline_retry"
        style="@style/Widget.Sprintly.WorkspaceTextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_retry"
        android:textColor="@color/orbix_warning" />
</LinearLayout>
