<resources>
    <style name="Widget.Sprintly.WorkspaceToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@color/orbix_surface</item>
        <item name="titleTextColor">@color/orbix_on_surface</item>
    </style>
    <style name="Widget.Sprintly.WorkspaceCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/orbix_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/orbix_divider</item>
    </style>
    <style name="Widget.Sprintly.WorkspaceButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:textColor">@color/auth_create_button_text</item>
        <item name="backgroundTint">@color/auth_create_button_background</item>
        <item name="iconTint">@color/auth_create_button_text</item>
    </style>
    <style name="Widget.Sprintly.WorkspaceTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:textColor">@color/orbix_selection</item>
        <item name="iconTint">@color/orbix_selection</item>
    </style>
    <style name="Widget.Sprintly.WorkspaceIconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/orbix_on_surface_variant</item>
    </style>
    <style name="Widget.Sprintly.WorkspaceRole" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_workspace_role</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">@color/orbix_selection</item>
    </style>
    <style name="Widget.Sprintly.WorkspaceList" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:clipToPadding">false</item>
    </style>
</resources>
