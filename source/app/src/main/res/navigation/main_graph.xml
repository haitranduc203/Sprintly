<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/welcome_fragment">

    <fragment
        android:id="@+id/welcome_fragment"
        android:name="com.example.sprintly.WelcomeFragment" />

    <fragment
        android:id="@+id/login_fragment"
        android:name="com.example.sprintly.ui.AuthFormFragment"
        android:label="@string/auth_login"
        tools:layout="@layout/fragment_auth_form" />

    <fragment
        android:id="@+id/register_fragment"
        android:name="com.example.sprintly.ui.AuthFormFragment"
        android:label="@string/auth_create_account"
        tools:layout="@layout/fragment_auth_form">
        <argument
            android:name="registration"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <navigation
        android:id="@+id/authenticated_graph"
        app:startDestination="@id/workspace_list_fragment">
        <fragment
            android:id="@+id/workspace_list_fragment"
            android:name="com.example.sprintly.ui.workspace.WorkspaceListFragment"
            android:label="@string/workspace_title"
            tools:layout="@layout/fragment_workspace_list" />
        <fragment
            android:id="@+id/account_fragment"
            android:name="com.example.sprintly.ui.AccountFragment"
            android:label="@string/auth_account"
            tools:layout="@layout/fragment_account" />
        <fragment
            android:id="@+id/workspace_detail_fragment"
            android:name="com.example.sprintly.ui.workspace.WorkspaceDetailFragment"
            tools:layout="@layout/fragment_workspace_detail">
            <argument android:name="workspaceId" app:argType="string" />
        </fragment>
        <fragment
            android:id="@+id/workspace_board_fragment"
            android:name="com.example.sprintly.ui.workspace.WorkspaceBoardFragment"
            android:label="@string/workspace_board"
            tools:layout="@layout/fragment_workspace_board">
            <argument android:name="workspaceId" app:argType="string" />
            <argument android:name="projectId" app:argType="string" />
        </fragment>
        <fragment
            android:id="@+id/task_search_fragment"
            android:name="com.example.sprintly.ui.tasks.TaskSearchFragment"
            android:label="@string/task_search_title"
            tools:layout="@layout/fragment_task_search">
            <argument android:name="workspaceId" app:argType="string" />
            <argument android:name="projectId" app:argType="string" />
        </fragment>
        <fragment
            android:id="@id/task_detail_fragment"
            android:name="com.example.sprintly.ui.tasks.TaskDetailFragment">
            <argument android:name="workspaceId" app:argType="string" />
            <argument android:name="projectId" app:argType="string" />
            <argument android:name="taskId" app:argType="string" />
        </fragment>
        <fragment
            android:id="@id/task_form_fragment"
            android:name="com.example.sprintly.ui.tasks.TaskFormFragment">
            <argument android:name="workspaceId" app:argType="string" />
            <argument android:name="projectId" app:argType="string" />
            <argument
                android:name="columnId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
            <argument
                android:name="taskId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </fragment>
    </navigation>
</navigation>
